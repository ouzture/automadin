{
  "manifest_version": 3,
  "name": "Automadin Browser Companion",
  "version": "0.2.92",
  "description": "Connect an explicitly granted browser tab to Automadin.",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage", "tabs", "userScripts"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "service_worker.js"},
  "action": {"default_title": "Connect this tab to Automadin"}
}
